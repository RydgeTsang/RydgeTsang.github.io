---
const {project}=Astro.props;const {entry:p,slug}=project;
---
<article class="project-card active bg-dark/60 border border-gray-700 rounded-lg p-6 card-hover" data-category={p.category}>
{p.cover&&<img src={p.cover} alt={p.title} class="w-full h-44 object-cover rounded-lg mb-5" loading="lazy"/>}
<h2 class="text-xl font-bold mb-3"><a href={`/projects/${slug}.html`}>{p.title}</a></h2><p class="text-gray-300 mb-5">{p.summary}</p>
{p.platforms?.length>0&&<p class="text-secondary text-sm mb-4">{p.platforms.map(platform=>platform.name).join(" · ")}</p>}
<div class="flex flex-wrap gap-2 mb-6">{p.tags.map(t=><span class="text-xs bg-gray-700 px-2 py-1 rounded">{t}</span>)}</div>
<div class="flex flex-wrap gap-4"><a href={`/projects/${slug}.html`} class="text-secondary">Details →</a>{p.source&&<a href={p.source} class="text-primary">Source Code</a>}{p.demo&&<a href={p.demo} class="text-primary">Demo</a>}</div>
</article>
