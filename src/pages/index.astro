---
import ProjectCard from '../components/ProjectCard.astro';
import {projects} from '../lib/projects';
const featured=(await projects()).filter(p=>p.entry.featured);
import Layout from '../components/Layout.astro';
import content from '../legacy/index.html?raw';
---
<Layout title="Index | Rydge's Code Space"><Fragment set:html={content} />{featured.length>0&&<section class="container mx-auto px-4 py-10"><h2 class="text-2xl font-bold mb-6">Featured Projects</h2><div class="grid md:grid-cols-3 gap-8">{featured.map(project=><ProjectCard project={project}/>)}</div></section>}</Layout>
<script is:inline>
        // Set current year in footer
        
        
        // Simple typing animation effect on page load
        document.addEventListener('DOMContentLoaded', () => {
            const welcomeText = document.querySelector('h1');
            welcomeText.classList.add('opacity-0');
            
            // Fade in animation
            setTimeout(() => {
                welcomeText.classList.remove('opacity-0');
                welcomeText.classList.add('transition-opacity', 'duration-1000', 'opacity-100');
            }, 300);
        });
    </script>
